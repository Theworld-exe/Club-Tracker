# =============================================================================
# Club Tracker — Environment Configuration Template
# =============================================================================
# Copy this file to `.env` and fill in your local values.
# NEVER commit `.env` or real API keys to version control.

# Required for AI Vision timetable scanning (PDF / PNG / JPEG / WEBP).
# Obtain an API key from Google AI Studio: https://aistudio.google.com/apikey
# You can also enter or update this key at runtime via the app's Settings modal.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override the default Gemini model used for timetable extraction.
# Default: gemini-3.8-flash (with automatic fallback across Gemini 3.x Flash models).
# GEMINI_MODEL=gemini-3.8-flash

# Optional: Custom path for the local SQLite database file.
# Default: ./club_scheduler.db (or next to ClubTracker.exe when bundled).
# CLUB_DB_PATH=club_scheduler.db

# Optional: Custom path for the .env file updated by the in-app Settings modal.
# Default: ./.env (or next to ClubTracker.exe when bundled).
# CLUB_ENV_PATH=.env
